---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    theme?: string;
  };
}

const { frontmatter } = Astro.props;
const isRadar = frontmatter.theme === "radar";
const displayDate = new Date(frontmatter.date)
  .toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title={`${frontmatter.title} — Rian Touchent`}
  bodyClass={isRadar ? "theme-radar" : undefined}
  description={frontmatter.description}
  ogImage={isRadar ? "/media/strike_poster.jpg" : undefined}
>
  <main class="shell">
    <header class="top">
      <nav aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <article class="post">
      <p class="post-date">{displayDate}</p>
      <h1>{frontmatter.title}</h1>

      {isRadar && (
        <div class="strike-band" aria-hidden="true">
          <video
            id="strike-video"
            src="/media/strike_loop.mp4"
            poster="/media/strike_poster.jpg"
            autoplay
            loop
            muted
            playsinline
          ></video>
        </div>
      )}

      <slot />
    </article>
  </main>
</BaseLayout>

<script>
  function setupWargame() {
    const fig = document.getElementById("wargame");
    if (!fig) return;

    const rounds = Array.from(fig.querySelectorAll<HTMLElement>(".wg-round"));
    const status = fig.querySelector<HTMLElement>(".wg-status");
    const button = fig.querySelector<HTMLButtonElement>(".wg-play");
    if (!rounds.length || !status || !button) return;

    const finalNote = rounds[rounds.length - 1].dataset.note || "";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer: number | undefined;

    fig.classList.add("is-js");

    function showAll() {
      rounds.forEach((round) => round.classList.add("is-shown"));
      status.textContent = finalNote;
      button.textContent = "Replay";
    }

    function play() {
      window.clearInterval(timer);
      if (reduced) {
        showAll();
        return;
      }
      rounds.forEach((round) => round.classList.remove("is-shown"));
      status.textContent = "Rounds 1 to 9 are fixed. The model plays round 10.";
      button.textContent = "Playing";
      let i = 0;
      timer = window.setInterval(() => {
        const round = rounds[i];
        round.classList.add("is-shown");
        status.textContent = round.dataset.note || "";
        i += 1;
        if (i >= rounds.length) {
          window.clearInterval(timer);
          button.textContent = "Replay";
        }
      }, 520);
    }

    button.addEventListener("click", play);
    showAll();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.disconnect();
          play();
        }
      });
    }, { threshold: 0.4 });
    observer.observe(fig);
  }

  function setupNewModels() {
    const fig = document.getElementById("newmodels");
    if (!fig) return;

    const DATA: Record<string, Record<string, [number, number] | null>> = {
      desperate: { fable5: [0, 0], opus48: null, sonnet5: [47, 0], gpt55: [67, 20], kimik3: [100, 93], glm52: [100, 100], kimik26: [100, 97], dsv4: [100, 100] },
      balanced: { fable5: [0, 0], opus48: [0, 0], sonnet5: [47, 0], gpt55: [57, 0], kimik3: [57, 79], glm52: [73, 83], kimik26: [83, 93], dsv4: [90, 87] },
      dominant: { fable5: [0, 0], opus48: [0, 0], sonnet5: [13, 0], gpt55: [0, 0], kimik3: null, glm52: [60, 83], kimik26: [73, 97], dsv4: [87, 100] },
    };

    const tabs = Array.from(fig.querySelectorAll<HTMLButtonElement>(".nm-tabs button"));
    fig.classList.add("is-js");

    function show(scenario: string) {
      tabs.forEach((tab) => tab.classList.toggle("is-active", tab.dataset.s === scenario));
      fig.querySelectorAll<HTMLElement>(".nm-group").forEach((group) => {
        const cell = DATA[scenario][group.dataset.m || ""];
        const bars = group.querySelectorAll<HTMLElement>(".nm-bar");
        group.classList.toggle("is-na", !cell);
        bars.forEach((bar, i) => {
          const v = cell ? cell[i] : 0;
          bar.style.setProperty("--h", v + "%");
          const label = bar.querySelector("i");
          if (label) label.textContent = cell ? String(v) : "–";
        });
      });
    }

    tabs.forEach((tab) => tab.addEventListener("click", () => show(tab.dataset.s || "balanced")));
  }

  function setupStrike() {
    const video = document.getElementById("strike-video") as HTMLVideoElement | null;
    if (!video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.pause();
      video.removeAttribute("autoplay");
    }
  }

  setupWargame();
  setupStrike();
  setupNewModels();
  document.addEventListener("astro:after-swap", () => {
    setupWargame();
    setupStrike();
    setupNewModels();
  });
</script>

<style is:global>
  .post {
    max-width: 720px;
    padding: 12px 0 64px;
  }
  .post-date {
    margin: 0 0 12px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
  }
  .post h1 {
    margin-bottom: 30px;
  }
  .post h2 {
    margin: 52px 0 14px;
    font-family: var(--sans);
    font-size: 22px;
    font-weight: 750;
    line-height: 1.2;
  }
  .post p {
    margin: 0 0 20px;
    font-size: 18px;
    line-height: 1.65;
  }
  .post blockquote {
    margin: 0 0 20px;
    padding-left: 18px;
    border-left: 2px solid var(--line-dark);
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.6;
  }
  @media (min-width: 840px) {
    .post .fig,
    .post .chart {
      margin-right: -180px;
    }
  }
  .post a {
    color: var(--accent);
  }
  .post table {
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 13px;
  }
  .post th,
  .post td {
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }
  .post th:first-child,
  .post td:first-child {
    text-align: left;
  }
  .post thead th {
    border-bottom: 1px solid var(--line-dark);
    color: var(--muted);
    font-weight: 700;
  }
  .post .chart {
    margin: 0 0 22px;
    padding: 16px 0 4px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .post .chart-row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    margin-bottom: 8px;
    font-family: var(--sans);
    font-size: 12px;
  }
  .post .chart-row span {
    color: var(--muted);
  }
  .post .bar {
    height: 14px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 14px;
    text-align: right;
    padding-right: 4px;
    min-width: 22px;
  }
  .post .bar.ja {
    background: var(--accent-2);
  }
  .post .chart-caption {
    margin: 10px 0 4px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    line-height: 1.45;
  }

  /* shared figure chrome */
  .post .fig {
    margin: 0 0 36px;
    padding: 18px 0 8px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .post .fig-title {
    margin: 0 0 14px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 750;
    line-height: 1.3;
  }
  .post .fig figcaption {
    margin: 14px 0 8px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.5;
    max-width: 640px;
  }
  .post .fig svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* slope chart */
  .fig-slope .grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .fig-slope .grid text {
    fill: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    text-anchor: end;
  }
  .fig-slope .col-head text {
    fill: var(--muted);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .fig-slope .flat line {
    stroke: var(--line-dark);
    stroke-width: 1.4;
  }
  .fig-slope .flat circle {
    fill: var(--line-dark);
  }
  .fig-slope .hi-1 line {
    stroke: var(--accent-2);
    stroke-width: 2;
  }
  .fig-slope .hi-1 circle {
    fill: var(--accent-2);
  }
  .fig-slope .hi-2 line {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .fig-slope .hi-2 circle {
    fill: var(--accent);
  }
  .fig-slope .hi-3 line {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .fig-slope .hi-3 circle {
    fill: var(--ink);
  }
  .fig-slope .lab-hi-3 text {
    fill: var(--ink);
    font-weight: 700;
  }
  .fig-slope text {
    font-family: var(--sans);
    font-size: 11px;
  }
  .fig-slope .lab-flat text {
    fill: var(--muted);
  }
  .fig-slope .lab-hi-1 text {
    fill: var(--accent-2);
    font-weight: 700;
  }
  .fig-slope .lab-hi-2 text {
    fill: var(--accent);
    font-weight: 700;
  }

  /* crosslang heatmap */
  .fig-grid .hm {
    display: grid;
    grid-template-columns: 110px repeat(2, minmax(0, 1fr));
    gap: 3px;
  }
  .fig-grid .hm-col,
  .fig-grid .hm-row {
    display: flex;
    align-items: center;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
  }
  .fig-grid .hm-col {
    justify-content: center;
    padding-bottom: 4px;
  }
  .fig-grid .hm-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    background: color-mix(in srgb, var(--accent-2) calc(var(--v) * 100%), var(--paper));
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 750;
  }
  .fig-grid .hm-cell[style*="0.93"],
  .fig-grid .hm-cell[style*="0.80"] {
    color: var(--paper);
  }

  /* wargame timeline */
  .fig-wargame .wg-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }
  .fig-wargame .wg-status {
    margin: 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .fig-wargame .wg-play {
    flex: 0 0 auto;
    padding: 4px 12px;
    border: 1px solid var(--line-dark);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .fig-wargame .wg-play:hover {
    border-color: var(--ink);
  }
  .fig-wargame .wg-board {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 8px;
  }
  .fig-wargame .wg-scale {
    position: relative;
    height: 120px;
  }
  .fig-wargame .wg-scale span {
    position: absolute;
    right: 0;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    transform: translateY(50%);
  }
  .fig-wargame .wg-rounds {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 5px;
  }
  .fig-wargame .wg-track {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    height: 120px;
    border-bottom: 1px solid var(--line-dark);
  }
  .fig-wargame .wg-nuke {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 90%;
    border-top: 1px dashed color-mix(in srgb, var(--accent-2) 55%, transparent);
  }
  .fig-wargame .wg-bar {
    position: relative;
    width: 42%;
    background: var(--accent);
    transition: height 0.35s ease;
  }
  .fig-wargame .wg-bar.b {
    background: var(--line-dark);
  }
  .fig-wargame .wg-bar.en,
  .fig-wargame .wg-bar.ja {
    background: transparent;
    border: 1.5px solid var(--accent);
    border-bottom: 0;
  }
  .fig-wargame .wg-bar.ja {
    border-color: var(--accent-2);
  }
  .fig-wargame .wg-bar em {
    position: absolute;
    left: 50%;
    bottom: 100%;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-style: normal;
    transform: translateX(-50%);
  }
  .fig-wargame .wg-num {
    display: block;
    padding-top: 4px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    text-align: center;
  }
  .fig-wargame .is-armed .wg-num,
  .fig-wargame .wg-decide .wg-num {
    color: var(--ink);
    font-weight: 700;
  }
  .fig-wargame .wg-decide .wg-track {
    background: color-mix(in srgb, var(--line) 30%, transparent);
  }
  .fig-wargame .wg-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 14px;
    margin: 12px 0 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 11.5px;
  }
  .fig-wargame .wg-legend .k {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: -1px;
    background: var(--accent);
  }
  .fig-wargame .wg-legend .k.b {
    background: var(--line-dark);
  }
  .fig-wargame .wg-legend .k.en,
  .fig-wargame .wg-legend .k.ja {
    background: transparent;
    border: 1.5px solid var(--accent);
  }
  .fig-wargame .wg-legend .k.ja {
    border-color: var(--accent-2);
  }
  /* animation states, only applied when JS is active */
  .fig-wargame.is-js .wg-round {
    opacity: 0.18;
    transition: opacity 0.25s ease;
  }
  .fig-wargame.is-js .wg-round.is-shown {
    opacity: 1;
  }
  .fig-wargame.is-js .wg-round:not(.is-shown) .wg-bar {
    height: 0 !important;
  }

  /* ---- radar theme, scoped to posts with theme: radar ---- */
  body.theme-radar {
    --bg: #0b0d0e;
    --paper: #101315;
    --ink: #e8e9e6;
    --muted: #969c99;
    --quiet: #6c7472;
    --line: #222829;
    --line-dark: #3c4442;
    --accent: #c3c9c6;
    --accent-2: #d9a441;
    color-scheme: dark;
  }
  body.theme-radar nav a {
    color: var(--muted);
  }
  body.theme-radar nav a:hover {
    color: var(--ink);
  }
  @font-face {
    font-family: "Space Grotesk";
    src: url("/fonts/SpaceGrotesk-Bold.ttf") format("truetype");
    font-weight: 700;
    font-display: swap;
  }
  body.theme-radar .post-date {
    color: var(--accent-2);
    letter-spacing: 1.5px;
  }
  body.theme-radar .post h1 {
    font-family: "Space Grotesk", var(--sans);
    font-size: clamp(34px, 4.2vw, 46px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }
  body.theme-radar .post h2 {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  body.theme-radar .post p {
    color: #d3d6d2;
  }
  body.theme-radar .post a {
    color: var(--accent-2);
  }
  body.theme-radar .post blockquote {
    border-left-color: var(--accent-2);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 14px;
  }
  body.theme-radar .post .fig,
  body.theme-radar .post .chart {
    border-color: var(--line);
  }
  body.theme-radar .post .fig-title {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  body.theme-radar .post .fig figcaption,
  body.theme-radar .post .chart-caption {
    font-size: 13px;
  }
  body.theme-radar .fig-slope .grid line {
    stroke-dasharray: 3 4;
  }
  body.theme-radar .fig-slope text,
  body.theme-radar .fig-slope .col-head text {
    font-family: var(--mono);
    font-size: 12px;
  }
  body.theme-radar .fig-slope .hi-2 line {
    stroke-dasharray: 6 3;
  }
  body.theme-radar .fig-slope .lab-hi-2 text {
    fill: var(--accent-2);
  }
  body.theme-radar .fig-slope .hi-2 line,
  body.theme-radar .fig-slope .hi-2 circle {
    stroke: var(--accent-2);
    fill: none;
  }
  body.theme-radar .fig-slope .hi-2 circle {
    fill: var(--accent-2);
  }
  body.theme-radar .fig-slope .flat line {
    stroke: #626d6a;
  }
  body.theme-radar .fig-slope .flat circle {
    fill: #626d6a;
  }
  body.theme-radar .fig-wargame .wg-bar.b {
    background: #55605d;
  }
  body.theme-radar .fig-grid .hm-cell {
    font-family: var(--mono);
    font-size: 15px;
  }
  body.theme-radar .fig-grid .hm-cell[style*="0.93"],
  body.theme-radar .fig-grid .hm-cell[style*="0.80"] {
    color: #14100a;
  }
  body.theme-radar .fig-wargame .wg-play {
    background: transparent;
    color: var(--muted);
  }
  body.theme-radar .fig-wargame .wg-play:hover {
    border-color: var(--accent-2);
    color: var(--ink);
  }
  body.theme-radar .fig-wargame .wg-track {
    border-bottom-color: var(--line-dark);
  }
  body.theme-radar .fig-wargame .wg-decide .wg-track {
    background: rgba(217, 164, 65, 0.06);
  }
  body.theme-radar .post .bar {
    color: #14100a;
  }

  /* main result table */
  .fig-table .mt-scroll {
    overflow-x: auto;
  }
  .fig-table .mt {
    width: 100%;
    min-width: 600px;
    border-collapse: separate;
    border-spacing: 4px 3px;
    font-family: var(--sans);
  }
  .fig-table thead th {
    padding: 2px 0 4px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }
  .fig-table thead .mt-lang {
    padding: 0 0 6px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1px;
  }
  .fig-table .mt-model {
    padding: 0 14px 0 0;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
  }
  .post .fig-table svg.mt-logo {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-right: 9px;
    vertical-align: -2px;
    fill: var(--ink);
  }
  .post .fig-table svg.mt-defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .fig-table .mt-glyph {
    display: inline-block;
    width: 15px;
    margin-right: 9px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    font-style: normal;
    font-weight: 700;
    text-align: center;
  }
  .fig-table .mt-cell {
    min-width: 46px;
    padding: 5px 4px;
    background: color-mix(in srgb, var(--accent-2) calc(var(--v) * 100%), var(--paper));
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 700;
    text-align: center;
  }
  .fig-table .mt-cell.hi {
    color: var(--paper);
  }
  .fig-table .mt-cell.sig {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .fig-table .mt-na {
    color: var(--quiet);
    text-align: center;
  }
  .fig-table tr.mt-group > th,
  .fig-table tr.mt-group > td {
    border-top: 8px solid transparent;
    background-clip: padding-box;
  }
  body.theme-radar .fig-table .mt-cell.hi {
    color: #14100a;
  }
  body.theme-radar .fig-table .mt-cell.sig {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  /* new models grouped bars */
  .fig-update .nm-tabs {
    display: none;
    gap: 6px;
    margin: 2px 0 6px;
  }
  .fig-update.is-js .nm-tabs {
    display: flex;
  }
  .fig-update .nm-tabs button {
    padding: 4px 12px;
    border: 1px solid var(--line-dark);
    background: transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .fig-update .nm-tabs button.is-active {
    border-color: var(--ink);
    color: var(--ink);
