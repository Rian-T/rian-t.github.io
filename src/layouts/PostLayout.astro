---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    theme?: string;
  };
}

const { frontmatter } = Astro.props;
const isRadar = frontmatter.theme === "radar";
---

<BaseLayout
  title={`${frontmatter.title} — Rian Touchent`}
  bodyClass={isRadar ? "theme-radar" : undefined}
>
  <main class="shell">
    <header class="top">
      <nav aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <article class="post">
      <p class="post-date">{frontmatter.date}</p>
      <h1>{frontmatter.title}</h1>

      {isRadar && (
        <div class="strike-band" id="strike" aria-hidden="true">
          <svg viewBox="40 24 560 224" preserveAspectRatio="xMidYMid meet">
            <defs>
              <filter id="strikeGlow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="1.6" result="b"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="b"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>
            <g filter="url(#strikeGlow)">
              <polyline class="sb-land" points="64,126 96,100 130,88 170,84 204,96 228,120 236,154 224,180 202,198 170,212 132,216 102,204 78,180 66,150 64,126"></polyline>
              <polyline class="sb-land" points="360,122 394,102 438,92 476,98 518,114 550,138 572,170 566,196 542,214 504,228 460,230 420,218 390,198 368,172 360,122"></polyline>
              <rect class="sb-cap" x="157" y="157" width="6" height="6"></rect>
              <rect class="sb-cap" x="483" y="157" width="6" height="6"></rect>
              <path class="sb-path" d="M160 160 Q323 40 486 160"></path>
              <rect class="sb-trail" x="-9" y="-9" width="4" height="4"></rect>
              <rect class="sb-trail" x="-9" y="-9" width="4" height="4"></rect>
              <rect class="sb-trail" x="-9" y="-9" width="4" height="4"></rect>
              <rect class="sb-head" x="-9" y="-9" width="5" height="5"></rect>
              <g class="sb-blast">
                <circle class="sb-core" cx="486" cy="160" r="0"></circle>
                <circle class="sb-ring" cx="486" cy="160" r="0"></circle>
                <circle class="sb-ring" cx="486" cy="160" r="0"></circle>
                <circle class="sb-ring" cx="486" cy="160" r="0"></circle>
              </g>
            </g>
          </svg>
        </div>
      )}

      <slot />
    </article>
  </main>
</BaseLayout>

<script>
  function setupWargame() {
    const fig = document.getElementById("wargame");
    if (!fig) return;

    const rounds = Array.from(fig.querySelectorAll<HTMLElement>(".wg-round"));
    const status = fig.querySelector<HTMLElement>(".wg-status");
    const button = fig.querySelector<HTMLButtonElement>(".wg-play");
    if (!rounds.length || !status || !button) return;

    const finalNote = rounds[rounds.length - 1].dataset.note || "";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer: number | undefined;

    fig.classList.add("is-js");

    function showAll() {
      rounds.forEach((round) => round.classList.add("is-shown"));
      status.textContent = finalNote;
      button.textContent = "Replay";
    }

    function play() {
      window.clearInterval(timer);
      if (reduced) {
        showAll();
        return;
      }
      rounds.forEach((round) => round.classList.remove("is-shown"));
      status.textContent = "Rounds 1 to 9 are fixed. The model plays round 10.";
      button.textContent = "Playing";
      let i = 0;
      timer = window.setInterval(() => {
        const round = rounds[i];
        round.classList.add("is-shown");
        status.textContent = round.dataset.note || "";
        i += 1;
        if (i >= rounds.length) {
          window.clearInterval(timer);
          button.textContent = "Replay";
        }
      }, 520);
    }

    button.addEventListener("click", play);
    showAll();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.disconnect();
          play();
        }
      });
    }, { threshold: 0.4 });
    observer.observe(fig);
  }

  function setupStrike() {
    const band = document.getElementById("strike");
    if (!band) return;

    const path = band.querySelector<SVGPathElement>(".sb-path");
    const head = band.querySelector<SVGRectElement>(".sb-head");
    const trails = Array.from(band.querySelectorAll<SVGRectElement>(".sb-trail"));
    const blast = band.querySelector<SVGGElement>(".sb-blast");
    const core = band.querySelector<SVGCircleElement>(".sb-core");
    const rings = Array.from(band.querySelectorAll<SVGCircleElement>(".sb-ring"));
    if (!path || !head || !blast || !core) return;

    const total = path.getTotalLength();
    path.style.strokeDasharray = String(total);

    function place(el: SVGRectElement, t: number) {
      const size = Number(el.getAttribute("width"));
      const p = path!.getPointAtLength(Math.max(0, Math.min(1, t)) * total);
      el.setAttribute("x", String(p.x - size / 2));
      el.setAttribute("y", String(p.y - size / 2));
    }

    function draw(progress: number) {
      path!.style.strokeDashoffset = String(total * (1 - progress));
      place(head!, progress);
      trails.forEach((el, i) => place(el, progress - 0.03 * (i + 1)));
    }

    function blastAt(phase: number) {
      const r = 8 + phase * 36;
      core!.setAttribute("r", String(r));
      rings.forEach((ring, i) => ring.setAttribute("r", String(r * [1.2, 1.8, 2.5][i])));
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      draw(1);
      blast.style.opacity = "0";
      return;
    }

    const FLY = 3000;
    const BLAST = 900;
    const FADE = 900;
    const PAUSE = 1200;
    const CYCLE = FLY + BLAST + FADE + PAUSE;
    let start = 0;

    function frame(now: number) {
      if (!start) start = now;
      const t = (now - start) % CYCLE;

      if (t < FLY) {
        draw(t / FLY);
        path!.style.opacity = "1";
        head!.style.opacity = "1";
        trails.forEach((el) => (el.style.opacity = "1"));
        blast!.style.opacity = "0";
      } else if (t < FLY + BLAST) {
        draw(1);
        head!.style.opacity = "0";
        trails.forEach((el) => (el.style.opacity = "0"));
        blast!.style.opacity = "1";
        blastAt((t - FLY) / BLAST);
      } else if (t < FLY + BLAST + FADE) {
        const f = 1 - (t - FLY - BLAST) / FADE;
        path!.style.opacity = String(f);
        blast!.style.opacity = String(f);
      } else {
        draw(0);
        path!.style.opacity = "1";
        blast!.style.opacity = "0";
      }
      window.requestAnimationFrame(frame);
    }

    draw(0);
    blast.style.opacity = "0";
    window.requestAnimationFrame(frame);
  }

  setupWargame();
  setupStrike();
  document.addEventListener("astro:after-swap", () => {
    setupWargame();
    setupStrike();
  });
</script>

<style is:global>
  .post {
    max-width: 680px;
    padding: 12px 0 40px;
  }
  .post-date {
    margin: 0 0 10px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }
  .post h1 {
    margin-bottom: 24px;
  }
  .post h2 {
    margin: 34px 0 10px;
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 750;
    line-height: 1.2;
  }
  .post p {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.6;
  }
  .post blockquote {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 2px solid var(--line-dark);
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }
  .post a {
    color: var(--accent);
  }
  .post table {
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 13px;
  }
  .post th,
  .post td {
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }
  .post th:first-child,
  .post td:first-child {
    text-align: left;
  }
  .post thead th {
    border-bottom: 1px solid var(--line-dark);
    color: var(--muted);
    font-weight: 700;
  }
  .post .chart {
    margin: 0 0 22px;
    padding: 16px 0 4px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .post .chart-row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    margin-bottom: 8px;
    font-family: var(--sans);
    font-size: 12px;
  }
  .post .chart-row span {
    color: var(--muted);
  }
  .post .bar {
    height: 14px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 14px;
    text-align: right;
    padding-right: 4px;
    min-width: 22px;
  }
  .post .bar.ja {
    background: var(--accent-2);
  }
  .post .chart-caption {
    margin: 10px 0 4px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    line-height: 1.45;
  }

  /* shared figure chrome */
  .post .fig {
    margin: 0 0 26px;
    padding: 14px 0 4px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .post .fig-title {
    margin: 0 0 12px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 750;
    line-height: 1.3;
  }
  .post .fig figcaption {
    margin: 12px 0 8px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    line-height: 1.45;
  }
  .post .fig svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* slope chart */
  .fig-slope .grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .fig-slope .grid text {
    fill: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    text-anchor: end;
  }
  .fig-slope .col-head text {
    fill: var(--muted);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .fig-slope .flat line {
    stroke: var(--line-dark);
    stroke-width: 1.4;
  }
  .fig-slope .flat circle {
    fill: var(--line-dark);
  }
  .fig-slope .hi-1 line {
    stroke: var(--accent-2);
    stroke-width: 2;
  }
  .fig-slope .hi-1 circle {
    fill: var(--accent-2);
  }
  .fig-slope .hi-2 line {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .fig-slope .hi-2 circle {
    fill: var(--accent);
  }
  .fig-slope text {
    font-family: var(--sans);
    font-size: 11px;
  }
  .fig-slope .lab-flat text {
    fill: var(--muted);
  }
  .fig-slope .lab-hi-1 text {
    fill: var(--accent-2);
    font-weight: 700;
  }
  .fig-slope .lab-hi-2 text {
    fill: var(--accent);
    font-weight: 700;
  }

  /* crosslang heatmap */
  .fig-grid .hm {
    display: grid;
    grid-template-columns: 110px repeat(2, minmax(0, 1fr));
    gap: 3px;
  }
  .fig-grid .hm-col,
  .fig-grid .hm-row {
    display: flex;
    align-items: center;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
  }
  .fig-grid .hm-col {
    justify-content: center;
    padding-bottom: 4px;
  }
  .fig-grid .hm-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    background: color-mix(in srgb, var(--accent-2) calc(var(--v) * 100%), var(--paper));
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 750;
  }
  .fig-grid .hm-cell[style*="0.93"],
  .fig-grid .hm-cell[style*="0.80"] {
    color: var(--paper);
  }

  /* wargame timeline */
  .fig-wargame .wg-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }
  .fig-wargame .wg-status {
    margin: 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .fig-wargame .wg-play {
    flex: 0 0 auto;
    padding: 4px 12px;
    border: 1px solid var(--line-dark);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .fig-wargame .wg-play:hover {
    border-color: var(--ink);
  }
  .fig-wargame .wg-board {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 8px;
  }
  .fig-wargame .wg-scale {
    position: relative;
    height: 120px;
  }
  .fig-wargame .wg-scale span {
    position: absolute;
    right: 0;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    transform: translateY(50%);
  }
  .fig-wargame .wg-rounds {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 5px;
  }
  .fig-wargame .wg-track {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    height: 120px;
    border-bottom: 1px solid var(--line-dark);
  }
  .fig-wargame .wg-nuke {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 90%;
    border-top: 1px dashed color-mix(in srgb, var(--accent-2) 55%, transparent);
  }
  .fig-wargame .wg-bar {
    position: relative;
    width: 42%;
    background: var(--accent);
    transition: height 0.35s ease;
  }
  .fig-wargame .wg-bar.b {
    background: var(--line-dark);
  }
  .fig-wargame .wg-bar.en,
  .fig-wargame .wg-bar.ja {
    background: transparent;
    border: 1.5px solid var(--accent);
    border-bottom: 0;
  }
  .fig-wargame .wg-bar.ja {
    border-color: var(--accent-2);
  }
  .fig-wargame .wg-bar em {
    position: absolute;
    left: 50%;
    bottom: 100%;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-style: normal;
    transform: translateX(-50%);
  }
  .fig-wargame .wg-num {
    display: block;
    padding-top: 4px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    text-align: center;
  }
  .fig-wargame .is-armed .wg-num,
  .fig-wargame .wg-decide .wg-num {
    color: var(--ink);
    font-weight: 700;
  }
  .fig-wargame .wg-decide .wg-track {
    background: color-mix(in srgb, var(--line) 30%, transparent);
  }
  .fig-wargame .wg-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 14px;
    margin: 12px 0 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 11.5px;
  }
  .fig-wargame .wg-legend .k {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: -1px;
    background: var(--accent);
  }
  .fig-wargame .wg-legend .k.b {
    background: var(--line-dark);
  }
  .fig-wargame .wg-legend .k.en,
  .fig-wargame .wg-legend .k.ja {
    background: transparent;
    border: 1.5px solid var(--accent);
  }
  .fig-wargame .wg-legend .k.ja {
    border-color: var(--accent-2);
  }
  /* animation states, only applied when JS is active */
  .fig-wargame.is-js .wg-round {
    opacity: 0.18;
    transition: opacity 0.25s ease;
  }
  .fig-wargame.is-js .wg-round.is-shown {
    opacity: 1;
  }
  .fig-wargame.is-js .wg-round:not(.is-shown) .wg-bar {
    height: 0 !important;
  }

  /* ---- radar theme, scoped to posts with theme: radar ---- */
  body.theme-radar {
    --bg: #0b0d0e;
    --paper: #101315;
    --ink: #e8e9e6;
    --muted: #969c99;
    --quiet: #6c7472;
    --line: #222829;
    --line-dark: #3c4442;
    --accent: #c3c9c6;
    --accent-2: #d9a441;
    color-scheme: dark;
  }
  body.theme-radar nav a {
    color: var(--muted);
  }
  body.theme-radar nav a:hover {
    color: var(--ink);
  }
  body.theme-radar .post-date {
    color: var(--accent-2);
    letter-spacing: 1.5px;
  }
  body.theme-radar .post h1 {
    letter-spacing: -0.01em;
  }
  body.theme-radar .post h2 {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  body.theme-radar .post p {
    color: #d3d6d2;
  }
  body.theme-radar .post a {
    color: var(--accent-2);
  }
  body.theme-radar .post blockquote {
    border-left-color: var(--accent-2);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 14px;
  }
  body.theme-radar .post .fig,
  body.theme-radar .post .chart {
    border-color: var(--line);
  }
  body.theme-radar .post .fig-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  body.theme-radar .post .fig figcaption,
  body.theme-radar .post .chart-caption {
    font-size: 11.5px;
  }
  body.theme-radar .fig-slope .grid line {
    stroke-dasharray: 3 4;
  }
  body.theme-radar .fig-slope text,
  body.theme-radar .fig-slope .col-head text {
    font-family: var(--mono);
    font-size: 10.5px;
  }
  body.theme-radar .fig-slope .hi-2 line {
    stroke-dasharray: 6 3;
  }
  body.theme-radar .fig-slope .lab-hi-2 text {
    fill: var(--accent-2);
  }
  body.theme-radar .fig-slope .hi-2 line,
  body.theme-radar .fig-slope .hi-2 circle {
    stroke: var(--accent-2);
    fill: none;
  }
  body.theme-radar .fig-slope .hi-2 circle {
    fill: var(--accent-2);
  }
  body.theme-radar .fig-slope .flat line {
    stroke: #626d6a;
  }
  body.theme-radar .fig-slope .flat circle {
    fill: #626d6a;
  }
  body.theme-radar .fig-wargame .wg-bar.b {
    background: #55605d;
  }
  body.theme-radar .fig-grid .hm-cell {
    font-family: var(--mono);
    font-size: 15px;
  }
  body.theme-radar .fig-grid .hm-cell[style*="0.93"],
  body.theme-radar .fig-grid .hm-cell[style*="0.80"] {
    color: #14100a;
  }
  body.theme-radar .fig-wargame .wg-play {
    background: transparent;
    color: var(--muted);
  }
  body.theme-radar .fig-wargame .wg-play:hover {
    border-color: var(--accent-2);
    color: var(--ink);
  }
  body.theme-radar .fig-wargame .wg-track {
    border-bottom-color: var(--line-dark);
  }
  body.theme-radar .fig-wargame .wg-decide .wg-track {
    background: rgba(217, 164, 65, 0.06);
  }
  body.theme-radar .post .bar {
    color: #14100a;
  }

  /* decorative strike band */
  .strike-band {
    margin: 0 0 26px;
    padding: 10px 0 12px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #020202;
  }
  .strike-band svg {
    display: block;
    width: 100%;
    height: 150px;
  }
  .strike-band .sb-land {
    fill: none;
    stroke: #ececec;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .strike-band .sb-cap {
    fill: #ececec;
  }
  .strike-band .sb-path {
    fill: none;
    stroke: #ececec;
    stroke-width: 2;
  }
  .strike-band .sb-head {
    fill: #ececec;
  }
  .strike-band .sb-trail {
    fill: #969696;
  }
  .strike-band .sb-core {
    fill: #ececec;
  }
  .strike-band .sb-ring {
    fill: none;
    stroke: #ececec;
    stroke-width: 1;
  }

  @media (max-width: 620px) {
    .fig-slope svg {
      min-width: 0;
    }
    .fig-grid .hm {
      grid-template-columns: 88px repeat(2, minmax(0, 1fr));
    }
    .fig-wargame .wg-rounds {
      gap: 3px;
    }
  }
</style>
