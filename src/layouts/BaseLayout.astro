---
import "../styles/global.css";

interface Props {
  title: string;
  bodyClass?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageCard?: "summary" | "summary_large_image";
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  preloadFonts?: string[];
  lang?: "en" | "fr";
  // Path of the same page in the other language, for hreflang.
  altLangPath?: string;
}

const {
  title,
  bodyClass,
  description,
  ogImage,
  ogImageAlt,
  ogImageCard = "summary_large_image",
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  preloadFonts = [],
  lang = "en",
  altLangPath,
} = Astro.props;
const altLang = lang === "en" ? "fr" : "en";
const site = "https://rian-t.github.io";
const ogImageUrl = ogImage ? site + ogImage : undefined;
const canonical = site + Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {altLangPath && <link rel="alternate" hreflang={lang} href={canonical} />}
    {altLangPath && <link rel="alternate" hreflang={altLang} href={site + altLangPath} />}
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Rian Touchent-Saad" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && <meta property="article:author" content="Rian Touchent-Saad" />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageUrl && <meta name="twitter:card" content={ogImageCard} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title="Rian Touchent-Saad" href="/rss.xml" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
