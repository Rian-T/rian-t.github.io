---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const modules = import.meta.glob("./*.md", { eager: true });
const posts = Object.values(modules)
  .map((mod: any) => ({
    url: mod.url as string,
    ...mod.frontmatter,
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<BaseLayout title="Blog — Rian Touchent">
  <main class="shell">
    <header class="top">
      <nav aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <PostList posts={posts.map((p: any) => ({ date: p.date, title: p.title, description: p.description, href: p.url }))} />
  </main>
</BaseLayout>
