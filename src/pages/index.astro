---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProfileIntro from "../components/ProfileIntro.astro";
import ReleaseGroups from "../components/ReleaseGroups.astro";
import SectionList from "../components/SectionList.astro";
import PostList from "../components/PostList.astro";
import { articles } from "../data/articles";
import { personJsonLd } from "../data/jsonld";

const modules = import.meta.glob("./blog/*.md", { eager: true });
const posts = Object.values(modules)
  .map((mod: any) => ({
    date: mod.frontmatter.date,
    title: mod.frontmatter.title,
    description: mod.frontmatter.description,
    href: mod.url,
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<BaseLayout
  title="Rian Touchent-Saad · AI researcher, LLMs in medicine"
  description="AI researcher at Inria Paris, PhD in AI. I train and evaluate LLMs, mainly in medicine. Author of CamemBERT-bio."
  ogImage="/assets/avatar.jpeg"
  ogImageCard="summary"
  altLangPath="/fr/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd("en"))} />
  <main class="shell shell-narrow">
    <Header lang="en" />
    <ProfileIntro />

    <div class="content-stack">
      <PostList posts={posts} />
      <SectionList id="articles" title="Articles" entries={articles} />
      <ReleaseGroups />
    </div>
  </main>
</BaseLayout>

